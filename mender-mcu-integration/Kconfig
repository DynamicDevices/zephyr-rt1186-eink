mainmenu "Mender Reference App"

menu "Mender Reference App"

menuconfig WIFI
bool "Mender App WIFI Configuration"
default n

if WIFI
	config MENDER_APP_WIFI_SSID
		string "WIFI SSID - Network name"
		default "my_network"

	config MENDER_APP_WIFI_PSK
		string "WIFI PSK - Network password key"
		default "secret_passwd"

endif # WIFI

	config MENDER_APP_NOOP_UPDATE_MODULE
		bool "Enable no-op Update Module"
		default n
		help
			An Update Module that does nothing. Useful for inspiration on how to get started writing
			your update module, as an alternative to the built-in zephyr-image Update module configured
			with MENDER_ZEPHYR_IMAGE_UPDATE_MODULE

	config APP_WAMR_OTA
		bool "Signed WAMR payload Update Module"
		default n
		depends on APP_EINK && MENDER_MCU_CLIENT
		select WAMR
		select WAMR_INTERP
		select FILE_SYSTEM
		select MBEDTLS
		select MBEDTLS_PSA_CRYPTO_C
		select MBEDTLS_PSA_STATIC_KEY_SLOTS
		select PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY
		select PSA_WANT_ECC_SECP_R1_256
		select PSA_WANT_ALG_ECDSA
		select PSA_WANT_ALG_SHA_256
		help
			Register the reboot-free Mender artifact type "wasm-module". Payloads
			must use the independently signed AESLWASM envelope and are staged in
			an inactive LittleFS slot before atomic activation.

	config APP_WAMR_OTA_ROOT
		string "WASM module slot directory"
		default "/lfs1/eink/wasm"
		depends on APP_WAMR_OTA

	config APP_WAMR_OTA_MAX_PAYLOAD_SIZE
		int "Maximum signed WASM payload bytes"
		default 65536
		range 1024 262144
		depends on APP_WAMR_OTA

	config APP_WAMR_OTA_SELFTEST
		bool "Run WASM A/B install and rollback self-test at boot"
		default n
		depends on APP_WAMR_OTA && ARCH_POSIX
		help
			Simulator-only lifecycle test. Streams two signed packages through the
			actual Mender callbacks and checks reboot-free activation, downgrade
			rejection, rollback, and recovery from a corrupt active slot.

	config APP_MENDER_CLIENT_ENABLE
		bool "Start the Mender client"
		default y
		help
			Disable only in focused native_sim profiles that exercise another
			long-running network client. Mender integration profiles keep this
			enabled.

	config APP_WIFI_SIM
		bool "Simulated Wi-Fi management interface (native_sim only)"
		default n
		depends on WIFI && NET_L2_WIFI_MGMT
		select WIFI_USE_NATIVE_NETWORKING
		help
			Registers a management-only Wi-Fi interface for the native_sim emulator so
			the improv-zephyr provisioning handshake can run end-to-end without a real
			radio. On "connect" it reports success and starts DHCPv4 on the native TAP
			Ethernet interface, which carries the Mender client's traffic. Do not enable
			on real hardware.

	config MENDER_APP_SERVER_HOST_ON_PREM_CERT
		string "Path to the DER formatted Mender Server Certificate. Relative to mender-mcu-integration"
		default ""
		help
			When in combination with MENDER_SERVER_HOST_ON_PREM, the Mender Reference App
			will add this credential as the MENDER_NET_CA_CERTIFICATE_TAG_PRIMARY.

	config APP_EINK
		bool "E-ink display + scheduler"
		default n
		help
			Enable packed-frame e-ink display service and scheduler
			(native_sim first; EL133UF1 SPI on RT1170 later).

if APP_EINK

	config APP_EINK_SHELL
		bool "E-ink shell commands"
		default y
		depends on SHELL

	config APP_EINK_T2000
		bool "T2000 USB host client (25\" Spectra 6 TCON)"
		default n
		depends on USB_HOST_STACK && UHC_DRIVER
		help
		  Thin vendor-bulk client for E Ink T2000 (VID 0x3558). Requires
		  FRDM Type-C OTG in host role with VBUS, and zephyr_uhc0 in DT
		  (boards/..._eink_t2000.overlay). Protocol SoT:
		  DynamicDevices/eink-t2000-usb.

	config APP_EINK_HTTP
		bool "e-tabelone HTTP client"
		default y
		select HTTP_CLIENT
		select DNS_RESOLVER
		select NET_SOCKETS
		help
		  Fetch schedule/config, download packed ES6F frames, and post
		  telemetry to the e-tabelone API (or file:// fixtures).

	config APP_EINK_HTTP_JSON_ARENA_SIZE
		int "cJSON parse arena (bytes)"
		depends on APP_EINK_HTTP
		default 262144
		range 16384 262144
		help
		  Static parse buffer for config JSON. 256 KiB matches EVK +
		  HyperRAM. FRDM with FlexSPI1/HyperRAM off must use 32–48 KiB
		  or the BSS will not fit in on-chip SRAM.

	config APP_EINK_HTTP_BOOT_INIT
		bool "Run eink_scheduler_init() from main()"
		default y
		depends on APP_EINK_HTTP
		help
		  When disabled, skip scheduler load at boot (HTTP objects still linked).

config APP_EINK_HTTP_CLIENT_BOOT_INIT
		bool "Run eink_http_init() from main()"
		default y
		depends on APP_EINK_HTTP
		help
		  When disabled, skip HTTP client/workqueue init at boot.

config APP_EINK_HTTP_ENABLE
		bool "Enable e-tabelone HTTP sync at boot"
		default n
		depends on APP_EINK_HTTP
		help
		  When set, start periodic sync after network is up. Requires
		  device id / token (Kconfig defaults or runtime credentials).

	config APP_EINK_HTTP_BASE_URL
		string "e-tabelone API base URL"
		depends on APP_EINK_HTTP
		default "https://api.dev.e-tabelone.com"

	config APP_EINK_HTTP_DEVICE_ID
		string "e-tabelone device id (empty = SoC UID hex)"
		depends on APP_EINK_HTTP
		default ""
		help
		  Leave empty so the app uses the SoC unique ID (hwinfo,
		  uppercase hex) as Etablone device_id — same string as Active
		  ESL onboard board_id. Override only for lab fixtures.
		  Auth remains the Bearer device token, not this id.

	config APP_EINK_HTTP_AUTH_TOKEN
		string "e-tabelone Bearer token (dev only; prefer runtime settings)"
		depends on APP_EINK_HTTP
		default ""
		help
		  Do not commit real tokens. Prefer Bitwarden-backed runtime
		  provisioning via eink_http_set_credentials().

	config APP_EINK_HTTP_CREDS_PERSIST
		bool "Persist e-tabelone credentials on LittleFS"
		depends on APP_EINK_HTTP
		default y
		help
		  Save api_base/device_id/auth_token to
		  APP_EINK_STORE_ROOT/creds.json when set via shell or API.
		  Reload at boot after eink_http_init. Plaintext on the e-ink
		  flash partition (not Mender NVS). Clear with token none/-.

	config APP_EINK_HTTP_POLL_INTERVAL
		int "e-tabelone poll interval (seconds)"
		depends on APP_EINK_HTTP
		default 300
		range 30 86400

	config APP_EINK_HTTP_V2_SYNC
		bool "Use /node/v2 radio-on-time sync (Cloudflare)"
		depends on APP_EINK_HTTP
		default n
		help
		  POST /node/v2/device/{id}/sync folds telemetry + config +
		  hash-diff download[] into one control-plane RTT. Asset bytes
		  still use GET /node/v0/.../assets/{id}.es6f.lz4. Falls back
		  to /node/v0 for file:// fixtures. Keep /node/v0 path when
		  this is disabled (AWS dual-run).

	config APP_EINK_RESOURCE_TELEMETRY
		bool "Report LittleFS + system-heap usage in telemetry"
		depends on APP_EINK_HTTP
		default y
		select SYS_HEAP_RUNTIME_STATS
		help
		  Adds optional telemetry fields storage_total_bytes,
		  storage_free_bytes, ram_heap_free_bytes,
		  ram_heap_used_bytes, ram_heap_max_used_bytes (omit a
		  group when the probe fails). Cloud must accept unknown
		  optional keys (v0 freeze: additive only).

	config APP_EINK_SCREEN_TYPE
		string "Board-reported screen_type for portal (13in|25in)"
		depends on APP_EINK_HTTP
		default ""
		help
		  Optional telemetry field screen_type. Cloud accepts only
		  "13in" or "25in" (portal Type column). Leave empty to omit.
		  FRDM EL133 / Spectra 6 13.3″ lab: set "13in".
		  When APP_EINK_PANEL_AUTODETECT is y, a successful probe
		  overrides this string at runtime.

	config APP_EINK_PANEL_AUTODETECT
		bool "Soft-detect connected e-ink controller at boot"
		depends on APP_EINK
		default y
		help
		  Probe which panel stack answered: EL133 glass (BUSY after
		  reset) and, when APP_EINK_T2000 is enabled, T2000 USB TCON.
		  Prefer T2000 if enumerated. Sets runtime screen_type for
		  telemetry (13in / 25in). Continues with panel=none when
		  nothing is found.

	config APP_EINK_PANEL_T2000_WAIT_MS
		int "T2000 USB enumerate wait (ms)"
		depends on APP_EINK_PANEL_AUTODETECT && APP_EINK_T2000
		default 3000
		range 500 30000
		help
		  How long panel detect waits for a T2000 VID/PID before
		  falling back to EL133 / none.

	config APP_EINK_DEBUG_LOG_UPLOAD
		bool "On-demand debug log ring + portal upload"
		depends on APP_EINK_HTTP
		default y
		help
		  Capture recent Zephyr log lines in a circular RAM ring and
		  POST them to /node/v0/device/{id}/debug-log when the cloud
		  sets request_debug_log or the operator runs eink log upload.

	config APP_EINK_DEBUG_LOG_RING_SIZE
		int "Debug log ring size (bytes)"
		depends on APP_EINK_DEBUG_LOG_UPLOAD
		default 32768
		range 4096 65536
		help
		  Circular buffer for formatted log text. Upload body is capped
		  at 64 KiB uncompressed by the cloud.

	config APP_EINK_HTTP_GALLERY_DEFER
		bool "Defer gallery ES6F downloads until after paint"
		depends on APP_EINK_HTTP
		default y
		help
		  Download and paint the due image first, then cache the remaining
		  schedule images on the HTTP workqueue (after deferred telemetry
		  when that option is enabled). Keeps time-to-first-frame short.
		  On CONFIG_APP_EINK_BATTERY_DUTY_CYCLE, gallery is skipped so
		  the radio can drop immediately after telemetry flush.

	config APP_EINK_HTTP_SKIP_GALLERY
		bool "Skip gallery prefetch (due/primary image only)"
		depends on APP_EINK_HTTP
		default n
		help
		  Do not download schedule images beyond the due/primary frame.
		  Required on boards with a small e-ink LittleFS (e.g. FRDM
		  ~1.75 MiB) where a multi-slot Demo campaign cannot cache
		  several ~0.5–1 MiB LZ4/ES6F objects. Still downloads and
		  paints the currently due image.

	config APP_EINK_HTTP_TELEMETRY_DEFER
		bool "Fire-and-forget telemetry after paint"
		depends on APP_EINK_HTTP
		default y
		help
		  Queue telemetry POST on the HTTP workqueue after the primary
		  paint so sync_once can return without waiting for the round
		  trip. Callers that power the radio down (duty-cycle wake)
		  must call eink_http_flush_deferred() first.

	config APP_EINK_HTTP_FAST_PATH
		bool "Telem-only sync when schedule is fresh and image is cached"
		depends on APP_EINK_HTTP
		default y
		help
		  If the last successful sync is within SYNC_MAX_AGE_SEC and the
		  due/current frame is already in the store, skip config fetch
		  and image download — only POST telemetry. Cuts ~1–2 s of
		  radio-awake time on warm wakes.

	config APP_EINK_HTTP_SYNC_MAX_AGE_SEC
		int "Max age of last sync before a full config fetch"
		depends on APP_EINK_HTTP_FAST_PATH
		default 300
		range 30 86400
		help
		  After this many seconds since last_sync, the next sync does a
		  full config fetch even if the panel image is already cached.

	config APP_EINK_WAKE_SKIP_RADIO_IF_CURRENT
		bool "Duty-cycle wake: skip radio when nothing new is due"
		depends on APP_EINK_HTTP && APP_EINK_BATTERY_DUTY_CYCLE
		default y
		help
		  After offline paint, if no new job is due and last_sync is
		  still fresh, leave IW612 off for this wake. Telemetry waits
		  until a later wake that needs config/download or age expiry.

	config APP_EINK_HTTP_CONFIG_CACHE
		bool "Skip config re-parse when body CRC is unchanged"
		depends on APP_EINK_HTTP
		default y
		help
		  Remember the last successful config body CRC32 and ETag.
		  Unchanged bodies reuse the prior schedule/image URL table.
		  When the server returns 304 Not Modified (If-None-Match),
		  skip the body entirely and reuse the RAM cache.

	config APP_EINK_STORE_QUICK_CACHE_CHECK
		bool "Treat ES6F cache hits as valid from header+size only"
		depends on APP_EINK
		default y
		help
		  has_valid_image() checks magic/geometry/file size without a
		  full payload CRC. Full CRC still runs when accepting a new
		  download. Speeds gallery skip checks on LittleFS.

	config APP_EINK_HTTP_SNTP_SERVER
		string "SNTP server for wall-clock (S3 pre-signed URLs)"
		depends on APP_EINK_HTTP && SNTP
		default "pool.ntp.org"
		help
		  Pre-signed S3 image URLs require a correct wall clock. When
		  CONFIG_SNTP is enabled, sync runs SNTP if time looks unset.

	config APP_EINK_LZ4
		bool "Accept LZ4-framed ES6F image downloads"
		depends on APP_EINK
		select APP_EINK_LZ4_LIB
		default y
		help
		  Accept HTTP/file bodies that are LZ4 frames (lz4 CLI format)
		  wrapping a complete ES6F v1 file. Raw ES6F remains accepted.
		  When to expand is selected below — pick based on wake power:
		  WiFi-on energy vs MCU+panel energy while painting.

	choice APP_EINK_LZ4_EXPAND_WHEN
		prompt "When to expand LZ4-framed ES6F"
		depends on APP_EINK_LZ4
		default APP_EINK_LZ4_EXPAND_ON_DOWNLOAD
		help
		  Expand-on-download: radio still up / just finished — pays CPU
		  and a full 960 KiB LittleFS write, then display is cheap.
		  Expand-on-display: store the small .es6f.lz4, drop WiFi
		  sooner / write less flash; pay decompress on each paint
		  (panel path). Measure both on real hardware.

	config APP_EINK_LZ4_EXPAND_ON_DOWNLOAD
		bool "Expand on download (store raw ES6F)"
		help
		  Decompress before accept. Best when the same frame is
		  repainted often offline and flash write cost is acceptable.

	config APP_EINK_LZ4_EXPAND_ON_DISPLAY
		bool "Expand on display (store .es6f.lz4)"
		help
		  Keep compressed object in the store; decompress into a
		  scratch ES6F when showing. Favours short WiFi-on windows
		  and denser gallery cache; costs MCU time on the paint path.

	endchoice

	config APP_EINK_LZ4_LIB
		bool
		depends on APP_EINK
		help
		  Build vendored LZ4 frame library (third_party/lz4).

	config APP_EINK_STORE_ROOT
		string "Host/FS root for frames and state"
		default "/tmp/eink-zephyr"

	config APP_EINK_FULL_FRAMEBUFFER
		bool "EVK panel-debug full framebuffer (960 KB)"
		default n
		help
		  Allocate one full Spectra-6 payload buffer for EL133 electrical
		  bring-up on the RT1170 EVK (typically placed in SDRAM). Must
		  remain disabled on the custom-board production / OCRAM-only
		  profile.

	config APP_EINK_DISPLAY_LCD_PREVIEW
		bool "Rocktech MIPI LCD preview (lab EVK stand-in)"
		depends on APP_EINK && DISPLAY
		default n
		help
		  Blit a scaled RGB565 preview of ES6F onto zephyr,display
		  (Rocktech RK055HDMIPI4MA0 720x1280 via --shield rk055hdmipi4ma0).
		  Lab-only: uses an ~1.8 MiB RGB565 framebuffer (EVK SDRAM).
		  Mutually exclusive with EL133/LPSPI1 e-ink images (LCDIF vs
		  lpspi1 pinmux). Not for the Active ESL product board.

	config APP_EINK_BATTERY_DUTY_CYCLE
		bool "Cold-boot duty-cycle wake machine (SNVS field mode)"
		default n
		help
		  Run one sync/display/OTA transaction then request main-rail-off
		  sleep instead of polling forever. Production battery boards
		  should enable this.

	config APP_EINK_DISPLAY_FIRE_AND_FORGET
		bool "Do not wait for panel refresh before advancing schedule / sleep"
		depends on APP_EINK_BATTERY_DUTY_CYCLE
		default y
		help
		  Queue the ES6F transfer and return immediately so the MCU can
		  drop WiFi and enter SNVS while the panel finishes its waveform.
		  Scheduler state advances on successful queue (not on refresh
		  completion). enter_snvs() leaves panel + data-NOR rails up
		  while a refresh is still in flight. Lab/shell builds without
		  BATTERY_DUTY_CYCLE still wait for idle.

	config APP_EINK_SNVS_SIM_HOLD_SEC
		int "native_sim: optional hold before returning from SNVS stub"
		default 0
		range 0 3600
		depends on APP_EINK_BATTERY_DUTY_CYCLE && ARCH_POSIX
		help
		  On native_sim, SNVS cannot cut power. When non-zero, sleep
		  min(time-to-next-wake, this many seconds) then return so
		  automated duty-cycle smokes can finish. Zero means log the
		  programmed wake and return immediately (no forever hang).

	config APP_EINK_SNVS_PMIC_OFF
		bool "RT118x: deassert PMIC_ON_REQ (BBNSM TOSP) on SNVS entry"
		depends on APP_EINK && SOC_SERIES_IMXRT118X
		default n
		help
		  True field sleep: dumb-PMIC + Turn Off System Power so
		  DCDC_IN / VDD_LPSR_IN drop and only BBNSM/SNVS stays up.
		  Wake is a CM33 cold boot from BBNSM RTC alarm (or ON/OFF).
		  FRDM-IMXRT1186 USB/onboard regs often ignore PMIC_ON_REQ —
		  enabling this may hang until a physical POR. Default off;
		  use shell "eink snvs <sec> cut" for a one-shot try.

	config APP_EINK_SNVS_DEFAULT_ALARM_SEC
		int "RT118x: default BBNSM RTC alarm if next_wake unset"
		depends on APP_EINK && SOC_SERIES_IMXRT118X
		default 20
		range 2 86400
		help
		  Lab default for "eink snvs" and enter_snvs() when wall
		  clock / next_wake is not a future unix time.

	config APP_EINK_BOM_POWER_LOOP
		bool "RT118x lab: loop BOM (TOSP) + BBNSM RTC wake for DMM"
		depends on APP_EINK && SOC_SERIES_IMXRT118X
		default n
		help
		  After boot, wait PRE_SEC then enter BOM via BBNSM TOSP with
		  a HOLD_SEC RTC alarm. True BOM wake is a full POR (loop via
		  reboot). If main 3V3 stays up (FRDM USB), WFI returns and
		  the loop retries in software. Unplug MCU-Link/OTG and measure
		  on the DC jack. Rebuild without this option to restore a
		  normal shell image.

	config APP_EINK_BOM_POWER_LOOP_PRE_SEC
		int "Seconds to wait before each BOM entry (Agilent settle)"
		depends on APP_EINK_BOM_POWER_LOOP
		default 5
		range 1 120

	config APP_EINK_BOM_POWER_LOOP_HOLD_SEC
		int "BBNSM RTC alarm seconds while in BOM"
		depends on APP_EINK_BOM_POWER_LOOP
		default 10
		range 2 600

	config APP_EINK_IW612_GPIO
		bool "Drive IW612 enable from zephyr,user iw612-enable-gpios"
		depends on APP_EINK && GPIO
		default y
		help
		  When the board overlay provides
		  /zephyr,user { iw612-enable-gpios = <...>; }, toggle that
		  GPIO in eink_power_iw612_set(). Without the property the
		  call remains a software-only hard-gate contract (logged).

	config APP_EINK_PANEL_GPIO
		bool "Drive panel rail from zephyr,user panel-enable-gpios"
		depends on APP_EINK && GPIO
		default y
		help
		  Optional panel rail GPIO via /zephyr,user panel-enable-gpios.

	config APP_EINK_OTA_FLASH_STAGING
		bool "Stage Mender artifacts on FlexSPI2 data NOR"
		default n
		depends on APP_EINK
		help
		  Download/validate OTA on FlexSPI2 staging partition, then copy
		  to FlexSPI1 slot1 with the radio gated and flash-critical code
		  in internal RAM.

	config APP_EINK_LOCATION
		bool "Optional WGS84 location in e-tabelone telemetry"
		depends on APP_EINK
		default y
		help
		  Persist a last-known fix under the e-ink store root and include
		  latitude/longitude (and optional location_accuracy_m) in
		  POST …/telemetry when a fix is present. Omit fields when no
		  fix. Lab: eink location set|clear. GNSS bridge:
		  CONFIG_APP_EINK_GNSS → eink_location_set() from Zephyr GNSS.

	config APP_EINK_GNSS
		bool "Zephyr GNSS driver → location telemetry bridge"
		depends on APP_EINK_LOCATION && GNSS
		default n
		help
		  Bind DT alias gnss, resume the device, and push fixes into
		  eink_location_set(). native_sim uses zephyr,gnss-emul; EVK
		  lab uses gnss-nmea-generic on a UART (pins TBD). Product BOM
		  may swap to a vendor-compatible (u-blox / Quectel / …).

	config APP_EINK_SELFTEST
		bool "Run e-ink unit self-tests at boot"
		default n

endif # APP_EINK

endmenu

source "Kconfig.zephyr"
